<?xml version="1.0" encoding="UTF-8"?>
<!--
  ALAS v3 frontend - IIS configuration (deploy at the site root next to index.html).
  Prerequisite: IIS URL Rewrite module (https://www.iis.net/downloads/microsoft/url-rewrite).
  WITHOUT it, remove the <rewrite> section and deep links will 404 (see docs/DEPLOYMENT_IIS.md).

  Layout assumed (same-origin):
      /            -> this SPA (dist/)
      /api/*       -> reverse-proxied to the ASP.NET Core API (ARR) or a separate site
  API paths are NEVER rewritten to index.html.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>

      <rewrite>
        <rules>
          <clear />
          <!-- SPA fallback: any path that is not a real file/dir and not /api -->
          <rule name="SPA fallback" stopProcessing="true">
            <match url=".*" />
            <conditions logicalGrouping="MatchAll">
              <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
              <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
              <add input="{URL}" pattern="^/api" negate="true" />
            </conditions>
            <action type="Rewrite" url="/index.html" />
          </rule>
        </rules>
      </rewrite>

      <!-- Security headers (defense in depth; the .NET API sets its own). -->
      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
          <add name="X-Content-Type-Options" value="nosniff" />
          <add name="X-Frame-Options" value="DENY" />
          <add name="Referrer-Policy" value="no-referrer" />
          <add name="Permissions-Policy" value="camera=(), geolocation=(), microphone=(), payment=()" />
          <add name="Content-Security-Policy" value="default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" />
        </customHeaders>
      </httpProtocol>

      <!-- Never cache the entry document: releases must be discoverable. -->
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>

      <httpErrors errorMode="Custom">
        <!-- Let the SPA render its own 404/403 screens for non-file routes. -->
        <remove statusCode="404" subStatusCode="-1" />
        <error statusCode="404" prefixAllPaths="false" path="/index.html" responseMode="Rewrite" />
      </httpErrors>

    </system.webServer>
  </location>

  <!-- Hashed build output: immutable long-lived caching. -->
  <location path="assets">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
      </staticContent>
      <httpProtocol>
        <customHeaders>
          <add name="Cache-Control" value="public, max-age=31536000, immutable" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>

  <!-- The MSW worker must never exist on a production site; if a stale copy
       is deployed by mistake, deny serving it. -->
  <location path="mockServiceWorker.js">
    <system.webServer>
      <security>
        <requestFiltering>
          <hiddenSegments>
            <add segment="mockServiceWorker.js" />
          </hiddenSegments>
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
